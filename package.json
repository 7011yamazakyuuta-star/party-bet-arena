{
  "name": "party-bet-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview",
    "lint": "tsc -b",
    "test:security": "node --test scripts/security-smoke.test.mjs",
    "test:rules": "node --test scripts/firebase-rules.test.mjs",
    "test:rules:emulator": "firebase emulators:exec --project demo-party-bet-security --only database \"npm run test:rules\"",
    "verify:qr": "node scripts/verify-qr-image.mjs"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-qr-code": "^2.0.18"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "websocket-driver": "^0.7.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "firebase-tools": "^15.34.0",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.5"
  }
}
